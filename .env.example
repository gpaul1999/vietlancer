# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).

# Domain công khai (có https khi đã cài SSL). Dùng cho CORS, link trong email, sitemap.
SITE_URL=https://tenmien.vn

# --- Bắt buộc ---
# Mật khẩu Postgres (đặt chuỗi ngẫu nhiên dài)
DB_PASSWORD=
# Khóa ký JWT — tối thiểu 32 ký tự. Sinh nhanh: openssl rand -base64 48
APP_JWT_SECRET=
# Mật khẩu tài khoản quản trị admin@vietlancer.vn (đăng nhập lần đầu xong nên đổi)
APP_ADMIN_PASSWORD=

# --- Tùy chọn ---
DB_NAME=vietlancer
DB_USER=vietlancer

# Seed dữ liệu demo (job/tài khoản mẫu) — production để false
APP_SEED_DEMO=false

# AI: local (miễn phí, mặc định) hoặc claude (cần ANTHROPIC_API_KEY)
APP_AI_CLASSIFIER=local
ANTHROPIC_API_KEY=

# Email thông báo + xác thực tài khoản + đặt lại mật khẩu.
# Bỏ trống: hệ thống vẫn chạy, link xác thực/đặt lại được ghi ra log server thay vì gửi mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Bắt buộc xác thực email mới được đăng job / chào giá.
# CHỈ bật sau khi SMTP đã hoạt động, nếu không người dùng mới sẽ bị khóa các chức năng chính.
APP_REQUIRE_VERIFIED_EMAIL=false
